# For desktop/localhost testing, keep these as-is.
# To test on a real phone (same Wi-Fi), replace localhost/127.0.0.1 with your
# PC's LAN IP, e.g. http://192.168.1.20:5000 and http://192.168.1.20:5001,
# and start Vite with: npm run dev -- --host
VITE_SERVER_DOMAIN=http://localhost:5000
VITE_NAV_DOMAIN=http://127.0.0.1:5001
VITE_MANAGER_PIN=1234
